# Copie para .env e preencha. Nunca versionar o .env.
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=central.kstec.online
DJANGO_CSRF_TRUSTED_ORIGINS=https://central.kstec.online
SITE_URL=https://central.kstec.online
DOMINIO=central.kstec.online
ACME_EMAIL=kaua@kstec.online

POSTGRES_DB=kscentral
POSTGRES_USER=kscentral
POSTGRES_PASSWORD=
DATABASE_URL=postgres://kscentral:${POSTGRES_PASSWORD}@db:5432/kscentral
REDIS_URL=redis://redis:6379/0

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
SENTRY_DSN=
EMAIL_URL=smtp+tls://usuario%40kstec.online:senha@smtp.servidor:587
DEFAULT_FROM_EMAIL="KS TEC <nao-responda@kstec.online>"
# Somente no perfil local: habilite depois de configurar o SMTP autorizado.
KSCENTRAL_EMAIL_REAL=False

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

STORAGE_BACKEND=local          # local | s3
AWS_S3_ENDPOINT_URL=
AWS_STORAGE_BUCKET_NAME=kscentral
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

NFSE_AMBIENTE=PRODUCAO_RESTRITA
TZ=America/Bahia
MFA_OBRIGATORIO=True

# Backups (scripts/backup.sh)
BACKUP_DIR=/srv/kscentral/backups
BACKUP_PASSPHRASE=
BACKUP_RCLONE_REMOTE=          # ex.: nextcloud:kscentral-backups (opcional)
